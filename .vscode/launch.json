{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      // "externalConsole": false,
      "externalConsole": true,
      // "cwd": "/home/lpr/Documents/Projects/licence_plate_recognition",
      "cwd": "${workspaceFolder}",
      // "program": "/home/lpr/Documents/Projects/licence_plate_recognition/build/Debug/outDebug",
      "program": "${workspaceFolder}/build/Debug/LPR",   // your output binary
      "MIMode": "gdb",
      "environment": [],
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}